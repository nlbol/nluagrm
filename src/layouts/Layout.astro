---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Núcleo Linux UAGRM</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
<script src="/js/lucide.min.js" is:inline></script>
<script is:inline>lucide.createIcons()</script>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0f0e13;
		--bg-alt: #17151f;
		--text: #f5f5f7;
		--text-muted: #a1a1aa;
		--accent: #4ade80;
		--accent-hover: #22c55e;
		--accent-2: #a78bfa;
		--accent-2-hover: #8b5cf6;
		--border: #262334;
		--card-bg: #17151f;
		--max-width: 1120px;
	}

*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
		background: var(--bg);
		overflow-x: hidden;
	}

	body {
		background: var(--bg);
		color: var(--text);
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
		line-height: 1.6;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
		padding-top: 60px;
	}

	a {
		color: var(--accent);
		text-decoration: none;
		transition: color 0.2s;
	}

	a:hover {
		color: var(--accent-hover);
	}

	img {
		max-width: 100%;
		height: auto;
	}

	::selection {
		background: var(--accent);
		color: var(--bg);
	}
</style>
