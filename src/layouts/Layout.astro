---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Núcleo Linux UAGRM</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --bg-alt: #f8f9fa;
    --text: #1a1a2e;
    --text-muted: #6b7280;
    --accent: #f97316;
    --accent-hover: #ea580c;
    --border: #e5e7eb;
    --card-bg: #ffffff;
    --max-width: 1120px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #051424;
      --bg-alt: #0a1e33;
      --text: #e2e8f0;
      --text-muted: #94a3b8;
      --accent: #22c55e;
      --accent-hover: #16a34a;
      --border: #1e3a5f;
      --card-bg: #0a1e33;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    padding-top: 60px;
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent-hover);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }
</style>
