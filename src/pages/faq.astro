---
import Layout from "../layouts/Layout.astro";
import faqData from "../../public/content/faq.json";

const faq = faqData.faq || [];
---

<Layout>
	<section class="section">
		<div class="content">
			<h1>Preguntas Frecuentes</h1>
			<p class="lead">Resolvé tus dudas sobre la comunidad.</p>
		</div>
	</section>

	<section class="section section-alt" id="faq">
		<div class="content">
			{faq.map((item, index) => (
				<details class="faq-item" open={index === 0}>
					<summary>{item.question}</summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</section>
</Layout>

<style>
	.section {
		padding: 4rem 2rem;
	}

	.section-alt {
		background: var(--bg-alt);
	}

	.content {
		max-width: 800px;
		margin: 0 auto;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		text-align: center;
	}

	.lead {
		text-align: center;
		color: var(--text-muted);
		max-width: 600px;
		margin: 1rem auto 0;
		font-size: 1.05rem;
	}

	.faq-item {
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--card-bg);
		margin-bottom: 1rem;
		overflow: hidden;
	}

	.faq-item summary {
		padding: 1.25rem 1.5rem;
		cursor: pointer;
		font-weight: 600;
		font-size: 1rem;
		list-style: none;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		transition: background 0.2s;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary::before {
		content: "▸";
		color: var(--accent);
		font-size: 1.1rem;
		transition: transform 0.2s;
	}

	.faq-item[open] summary::before {
		transform: rotate(90deg);
	}

	.faq-item summary:hover {
		background: rgba(255, 255, 255, 0.02);
	}

	.faq-item p {
		padding: 0 1.5rem 1.25rem;
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.7;
	}

	@media (max-width: 768px) {
		.section {
			padding: 3rem 1.25rem;
		}

		.faq-item summary {
			padding: 1rem 1.25rem;
			font-size: 0.95rem;
		}

		.faq-item p {
			padding: 0 1.25rem 1rem;
			font-size: 0.9rem;
		}
	}
</style>
