---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="section">
    <div class="content">
      <h1>Blog y Noticias</h1>
      <p class="lead">Tutoriales técnicos, crónicas de eventos, artículos de opinión y novedades de la comunidad.</p>
    </div>
  </section>

  <section class="section section-alt" id="filtros">
    <div class="content">
      <div class="filters" id="filters">
        <span class="filter active" data-tag="all">Todos</span>
      </div>
    </div>
  </section>

  <section class="section" id="articulos">
    <div class="content">
      <div class="feed" id="feed"></div>
      <div class="post-view" id="post-view" style="display:none">
        <button class="back-btn" id="back-btn">← Volver al listado</button>
        <div id="post-content"></div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="newsletter">
    <div class="content newsletter-box">
      <h2>Newsletter</h2>
      <p>Suscribite para recibir novedades académicas, convocatorias y resúmenes mensuales.</p>
      <form class="subscribe">
        <input type="email" placeholder="tu@correo.com" required />
        <button type="submit">Suscribirse</button>
      </form>
    </div>
  </section>
</Layout>

<script>
  let posts = [];
  let currentTag = "all";

  function formatDate(iso) {
    const d = new Date(iso + "T00:00:00");
    return d.toLocaleDateString("es-ES", {
      day: "numeric",
      month: "long",
      year: "numeric",
    });
  }

  function getTagLabel(tags) {
    return tags?.[0] || "General";
  }

  function renderFeed() {
    const feed = document.getElementById("feed");
    const filtered = currentTag === "all" ? posts : posts.filter((p) => p.tags?.includes(currentTag));
    feed.innerHTML = filtered
      .map(
        (p) => `
      <article class="post" data-slug="${p.slug}">
        <span class="tag">${getTagLabel(p.tags)}</span>
        <h3>${p.title}</h3>
        <p class="excerpt">${p.excerpt}</p>
        <span class="meta">Por ${p.author} — ${formatDate(p.date)}</span>
      </article>`,
      )
      .join("");
  }

  async function openPost(slug) {
    const feed = document.getElementById("feed");
    const view = document.getElementById("post-view");
    const content = document.getElementById("post-content");
    feed.style.display = "none";
    view.style.display = "block";
    content.innerHTML = "<p class='loading'>Cargando...</p>";
    try {
      const res = await fetch(`/content/posts/${slug}.md`);
      const md = await res.text();
      content.innerHTML = marked.parse(md);
      content.querySelectorAll("pre code").forEach((b) => {
        b.style.background = "var(--bg-alt)";
        b.style.padding = "0.2rem 0.4rem";
        b.style.borderRadius = "4px";
      });
    } catch {
      content.innerHTML = "<p>Error al cargar el artículo.</p>";
    }
  }

  document.addEventListener("click", (e) => {
    const post = e.target.closest(".post");
    if (post) {
      openPost(post.dataset.slug);
    }
  });

  document.getElementById("back-btn")?.addEventListener("click", () => {
    document.getElementById("feed").style.display = "";
    document.getElementById("post-view").style.display = "none";
  });

  document.getElementById("filters")?.addEventListener("click", (e) => {
    const btn = e.target.closest(".filter");
    if (!btn) return;
    document.querySelectorAll(".filter").forEach((f) => f.classList.remove("active"));
    btn.classList.add("active");
    currentTag = btn.dataset.tag;
    renderFeed();
  });

  fetch("/content/posts/index.json")
    .then((r) => r.json())
    .then((data) => {
      posts = data;
      const tags = [...new Set(data.flatMap((p) => p.tags || []))];
      const filtersEl = document.getElementById("filters");
      tags.forEach((t) => {
        const span = document.createElement("span");
        span.className = "filter";
        span.dataset.tag = t;
        span.textContent = t.charAt(0).toUpperCase() + t.slice(1);
        filtersEl.appendChild(span);
      });
      renderFeed();
    });
</script>

<style>
  .section {
    padding: 4rem 2rem;
  }

  .section-alt {
    background: var(--bg-alt);
  }

  .content {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .lead {
    text-align: center;
    color: var(--text-muted);
    max-width: 600px;
    margin: 1rem auto 0;
    font-size: 1.05rem;
  }

  .filters {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .filter {
    padding: 0.4rem 1rem;
    border: 1px solid var(--border);
    border-radius: 20px;
    font-size: 0.85rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
  }

  .filter.active,
  .filter:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .feed {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    cursor: pointer;
    transition: box-shadow 0.2s;
  }

  .post:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  .tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .post h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .excerpt {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .meta {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .back-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: all 0.2s;
  }

  .back-btn:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  .post-view h1,
  .post-view h2,
  .post-view h3 {
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .post-view p {
    margin-bottom: 1em;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .post-view pre {
    background: var(--bg-alt);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1em 0;
  }

  .post-view code {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.9em;
  }

  .post-view ul,
  .post-view ol {
    margin: 0.5em 0 1em 1.5em;
    color: var(--text-muted);
  }

  .post-view li {
    margin-bottom: 0.25em;
  }

  .post-view a {
    color: var(--accent);
  }

  .post-view blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1em 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .loading {
    color: var(--text-muted);
  }

  .newsletter-box {
    text-align: center;
  }

  .newsletter-box h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .newsletter-box p {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .subscribe {
    display: flex;
    gap: 0.5rem;
    max-width: 400px;
    margin: 0 auto;
  }

  .subscribe input {
    flex: 1;
    padding: 0.6rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.9rem;
  }

  .subscribe button {
    padding: 0.6rem 1.5rem;
    border: none;
    border-radius: 6px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .subscribe button:hover {
    opacity: 0.9;
  }
</style>
