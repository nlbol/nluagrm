---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="section">
		<div class="content">
			<h2>Comunidad</h2>
			<p>Sumate a nuestros canales, participá de las reuniones y colaborá con el crecimiento del software libre en la UAGRM. Todos los niveles de conocimiento son bienvenidos.</p>
		</div>
	</section>
</Layout>

<style>
	.section {
		min-height: 60vh;
		padding: 120px 40px;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.content {
		max-width: 680px;
		text-align: center;
	}
	.content h2 {
		font-size: 2rem;
		margin: 0 0 1rem;
		color: #1a1a2e;
	}
	.content p {
		font-size: 1.1rem;
		line-height: 1.8;
		color: #555;
	}
</style>
