---
import Layout from "../layouts/Layout.astro";
import OrganizationGroup from "../components/OrganizationGroup.astro";
import membersData from "../../public/content/members.json";

const members = membersData.members || [];

const groupOrder = ["founder", "founding-member", "board"] as const;
const groupLabels: Record<string, string> = {
	founder: "Fundadores",
	"founding-member": "Miembros Fundadores",
	board: "Directiva Actual",
};

const grouped = new Map<string, typeof members>();
for (const m of members) {
	const g = m.group || "board";
	if (!grouped.has(g)) grouped.set(g, []);
	grouped.get(g)!.push(m);
}
---

<Layout>
	<section class="section">
		<div class="content">
			<h1>Comunidad</h1>
			<p class="lead">Conocé a la organización, sus fundadores y la directiva actual que impulsa la comunidad.</p>
		</div>
	</section>

	<section class="section section-alt" id="organizacion">
		<div class="content">
			<h2>Organización</h2>
			<div class="org-container">
				{groupOrder.filter((g) => grouped.has(g)).map((g, i) => (
					<>
						{i > 0 && <div class="org-divider"></div>}
						<OrganizationGroup
							title={groupLabels[g]}
							members={grouped.get(g)!}
						/>
					</>
				))}
			</div>
		</div>
	</section>

	<section class="section section-compact" id="unirse">
		<div class="content">
			<h2>Sumate al Equipo</h2>
			<p class="form-intro">Escribinos a <strong>fershouno@proton.me</strong> para coordinar tu incorporación.</p>
		</div>
	</section>
</Layout>

<style>
	.section {
		padding: 4rem 2rem;
	}

	.section-alt {
		background: var(--bg-alt);
	}

	.content {
		max-width: var(--max-width);
		margin: 0 auto;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		text-align: center;
	}

	h2 {
		font-size: clamp(1.3rem, 2.5vw, 1.75rem);
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.lead {
		text-align: center;
		color: var(--text-muted);
		max-width: 600px;
		margin: 1rem auto 0;
		font-size: 1.05rem;
	}

	.form-intro {
		text-align: center;
		color: var(--text-muted);
		max-width: 500px;
		margin: 0 auto;
		font-size: 1rem;
	}

	.section-compact {
		padding: 2rem 2rem;
	}

	.org-container {
		max-width: 900px;
		margin: 0 auto;
	}

	.org-divider {
		height: 1px;
		background: var(--border);
		margin: 0.5rem 0 2.5rem;
	}
</style>
