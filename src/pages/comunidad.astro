---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="section">
    <div class="content">
      <h1>Comunidad y Proyectos</h1>
      <p class="lead">Conocé nuestros proyectos activos, colaboradores principales y unite al equipo.</p>
    </div>
  </section>

  <section class="section section-alt" id="proyectos">
    <div class="content">
      <h2>Proyectos Activos</h2>
      <div class="grid">
        <div class="card">
          <h3>Linux Mirrors</h3>
          <p>Espejos de distribuciones Linux para la comunidad universitaria y el país.</p>
          <span class="status">Producción</span>
        </div>
        <div class="card">
          <h3>Auth Proxy</h3>
          <p>Sistema de autenticación y proxy para servicios internos de la universidad.</p>
          <span class="status">Desarrollo</span>
        </div>
        <div class="card">
          <h3>Wiki Comunitaria</h3>
          <p>Base de conocimiento colaborativa con guías, tutoriales y documentación técnica.</p>
          <span class="status">Beta</span>
        </div>
        <div class="card">
          <h3>Bot de Discord</h3>
          <p>Asistente automatizado para la gestión del servidor de la comunidad.</p>
          <span class="status">Mantenimiento</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="contribuidores">
    <div class="content">
      <h2>Contribuidores Principales</h2>
      <div class="grid">
        <div class="profile">
          <div class="avatar"></div>
          <h3>Nombre del Arquitecto</h3>
          <p class="role">Arquitecto de Infraestructura</p>
          <p class="bio">Descripción breve del rol y contribuciones dentro de la comunidad.</p>
        </div>
        <div class="profile">
          <div class="avatar"></div>
          <h3>Nombre del Maintainer</h3>
          <p class="role">Maintainer de Proyectos</p>
          <p class="bio">Descripción breve del rol y contribuciones dentro de la comunidad.</p>
        </div>
        <div class="profile">
          <div class="avatar"></div>
          <h3>Nombre del Líder</h3>
          <p class="role">Líder de Comunidad</p>
          <p class="bio">Descripción breve del rol y contribuciones dentro de la comunidad.</p>
        </div>
        <div class="profile">
          <div class="avatar"></div>
          <h3>Nombre del Docente</h3>
          <p class="role">Asesor Académico</p>
          <p class="bio">Descripción breve del rol y contribuciones dentro de la comunidad.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="unirse">
    <div class="content">
      <h2>Sumate al Equipo</h2>
      <form class="join-form">
        <div class="form-row">
          <input type="text" placeholder="Nombre completo" required />
          <input type="email" placeholder="Correo universitario" required />
        </div>
        <div class="form-row">
          <input type="text" placeholder="Carrera" />
          <input type="text" placeholder="Semestre" />
        </div>
        <div class="form-row">
          <select>
            <option>Área de interés</option>
            <option>Difusión</option>
            <option>Instalación</option>
            <option>Logística</option>
            <option>Desarrollo</option>
            <option>Investigación</option>
            <option>Infraestructura</option>
          </select>
        </div>
        <textarea placeholder="Contanos por qué querés sumarte y qué conocimientos tenés..." rows="4"></textarea>
        <button type="submit">Enviar solicitud</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 4rem 2rem;
  }

  .section-alt {
    background: var(--bg-alt);
  }

  .content {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .lead {
    text-align: center;
    color: var(--text-muted);
    max-width: 600px;
    margin: 1rem auto 0;
    font-size: 1.05rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .status {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
  }

  .profile {
    text-align: center;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem 1.5rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .profile:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--border);
    margin: 0 auto 1rem;
  }

  .profile h3 {
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }

  .role {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .bio {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .join-form {
    max-width: 600px;
    margin: 2rem auto 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .join-form input,
  .join-form select,
  .join-form textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.9rem;
  }

  .join-form textarea {
    resize: vertical;
    font-family: inherit;
  }

  .join-form button {
    padding: 0.75rem 2rem;
    background: var(--accent);
    color: var(--bg);
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    align-self: flex-end;
    transition: opacity 0.2s;
  }

  .join-form button:hover {
    opacity: 0.9;
  }

  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
