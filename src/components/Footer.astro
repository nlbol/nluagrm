---
import { footerPlatforms, footerSocials } from "../config/footer";
---

<footer>
	<div class="footer-inner">
		<div class="footer-col">
			<h4>Núcleo Linux UAGRM</h4>
			<p>Comunidad de Software Libre y Código Abierto de la Universidad Autónoma Gabriel René Moreno.</p>
		</div>

		<div class="footer-col">
			<h4>Plataforma</h4>
			{footerPlatforms.map((p) => (
				<a href={p.url}>{p.name}</a>
			))}
		</div>

		<div class="footer-col">
			<h4>Redes</h4>
			{footerSocials.map((s) => (
				<a href={s.url}>{s.name}</a>
			))}
		</div>
	</div>

	<div class="footer-bottom">
		<p>© 2026 Núcleo Linux UAGRM. Santa Cruz, Bolivia.</p>
	</div>
</footer>

<style>
	footer {
		background: var(--bg-alt);
		border-top: 1px solid var(--border);
		padding: 3rem 40px 1.5rem;
		margin-top: 4rem;
	}

	.footer-inner {
		max-width: var(--max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 2rem;
	}

	.footer-col h4 {
		margin-bottom: 0.75rem;
		font-size: 1rem;
	}

	.footer-col p {
		color: var(--text-muted);
		font-size: 0.875rem;
		line-height: 1.5;
	}

	.footer-col a {
		display: block;
		color: var(--text-muted);
		font-size: 0.875rem;
		padding: 0.2rem 0;
		transition: color 0.2s;
	}

	.footer-col a:hover {
		color: var(--accent);
	}

	.footer-bottom {
		max-width: var(--max-width);
		margin: 2rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		text-align: center;
		color: var(--text-muted);
		font-size: 0.8rem;
	}
</style>
