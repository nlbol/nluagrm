---
interface Slide {
	title?: string;
	description?: string;
	image?: string;
	img?: string;
	url?: string;
}

interface Props {
	data: Slide[];
	id?: string;
}

const { data, id = "slider" } = Astro.props;
---

<div class="slider" id={id}>
	{data.map((s) => (
		<a href={s.url || '#'} class="slide" target={s.url ? '_blank' : ''} rel="noopener">
			<div class="slide-img">
				<img src={s.image || s.img || ''} alt={s.title || ''} loading="lazy" />
				<div class="slide-overlay">
					<h3>{s.title}</h3>
				</div>
			</div>
		</a>
	))}
</div>

<style is:global>
	.slider {
		display: flex;
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding: 1rem 0;
		scroll-behavior: smooth;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	.slider::-webkit-scrollbar {
		display: none;
	}

	.slide {
		flex: 0 0 85%;
		scroll-snap-align: start;
		border-radius: 16px;
		overflow: hidden;
		background: var(--card-bg);
		border: 1px solid var(--border);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
		transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
		cursor: pointer;
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.slide:hover {
		transform: translateY(-6px) scale(1.02);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(74, 222, 128, 0.15);
		border-color: var(--accent);
	}

	.slide-img {
		position: relative;
		overflow: hidden;
	}

	.slide-img img {
		width: 100%;
		height: 200px;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}

	.slide:hover .slide-img img {
		transform: scale(1.08);
	}

	.slide-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
		padding: 2rem 1rem 0.8rem;
		transform: translateY(100%);
		transition: transform 0.35s ease;
	}

	.slide:hover .slide-overlay {
		transform: translateY(0);
	}

	.slide-overlay h3 {
		font-size: 1rem;
		color: #fff;
		font-weight: 600;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
	}

	@media (min-width: 768px) {
		.slide {
			flex: 0 0 45%;
		}
	}
</style>

<script>
	function initSlider(slider: HTMLElement) {
		if (slider.dataset.init) return;
		slider.dataset.init = "1";

		const slides = slider.querySelectorAll('.slide');
		if (slides.length === 0) return;

		let currentIndex = 0;
		let interval: ReturnType<typeof setInterval>;

		function nextSlide() {
			currentIndex = (currentIndex + 1) % slides.length;
			const slideWidth = (slides[0] as HTMLElement).offsetWidth + 16;
			slider.scrollTo({ left: slideWidth * currentIndex, behavior: 'smooth' });
		}

		function startAuto() {
			clearInterval(interval);
			interval = setInterval(nextSlide, 3000);
		}

		function updateIndex() {
			const slideWidth = (slides[0] as HTMLElement).offsetWidth + 16;
			currentIndex = Math.round(slider.scrollLeft / slideWidth) % slides.length;
		}

		slider.addEventListener('wheel', (e) => {
			const { deltaY } = e;
			if (Math.abs(deltaY) < 1) return;
			e.preventDefault();
			slider.scrollBy({ left: deltaY, behavior: 'auto' });
			updateIndex();
		}, { passive: false });

		startAuto();
		slider.addEventListener('mouseenter', () => clearInterval(interval));
		slider.addEventListener('mouseleave', startAuto);
	}

	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll<HTMLElement>('.slider').forEach(initSlider);
	});
</script>
