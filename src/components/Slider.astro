---
---

<div class="slider" id="autoSlider"></div>

<style is:global>
	.slider {
		display: flex;
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding: 1rem 0;
		scroll-behavior: smooth;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	.slider::-webkit-scrollbar {
		display: none;
	}

	.slide {
		flex: 0 0 85%;
		scroll-snap-align: start;
		border-radius: 16px;
		overflow: hidden;
		background: var(--card-bg);
		border: 1px solid var(--border);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
		transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
		cursor: pointer;
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.slide:hover {
		transform: translateY(-6px) scale(1.02);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(74, 222, 128, 0.15);
		border-color: var(--accent);
	}

	.slide-img {
		position: relative;
		overflow: hidden;
	}

	.slide-img img {
		width: 100%;
		height: 200px;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}

	.slide:hover .slide-img img {
		transform: scale(1.08);
	}

	.slide-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
		padding: 2rem 1rem 0.8rem;
		transform: translateY(100%);
		transition: transform 0.35s ease;
	}

	.slide:hover .slide-overlay {
		transform: translateY(0);
	}

	.slide-overlay h3 {
		font-size: 1rem;
		color: #fff;
		font-weight: 600;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
	}

	@media (min-width: 768px) {
		.slide {
			flex: 0 0 45%;
		}

		.slide-overlay {
			transform: translateY(100%);
		}

		.slide:hover .slide-overlay {
			transform: translateY(0);
		}
	}

	.slide-overlay {
		transform: translateY(0);
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', async () => {
		const slider = document.getElementById('autoSlider');
		if (!slider) return;

		let slides;
		try {
			const res = await fetch('/content/slides.json');
			slides = await res.json();
		} catch {
			return;
		}
		if (!slides || slides.length === 0) return;

		slider.innerHTML = slides
			.map(
				(s) =>
					`<a href="${s.url || '#'}" class="slide" target="${s.url ? '_blank' : ''}" rel="noopener">
						<div class="slide-img">
							<img src="${s.img}" alt="${s.title}" loading="lazy" />
							<div class="slide-overlay">
								<h3>${s.title}</h3>
							</div>
						</div>
					</a>`,
			)
			.join('');

		const slideEls = slider.querySelectorAll('.slide');
		if (slideEls.length === 0) return;

		let currentIndex = 0;
		let interval;

		function nextSlide() {
			currentIndex = (currentIndex + 1) % slideEls.length;
			const slideWidth = slideEls[0].offsetWidth + 16;
			slider.scrollTo({ left: slideWidth * currentIndex, behavior: 'smooth' });
		}

		function startAuto() {
			clearInterval(interval);
			interval = setInterval(nextSlide, 3000);
		}

		startAuto();
		slider.addEventListener('mouseenter', () => clearInterval(interval));
		slider.addEventListener('mouseleave', startAuto);
	});
</script>
